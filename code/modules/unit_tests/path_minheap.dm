// Exercise the real heap and PathNode datums without adding a terrain fixture.
/datum/unit_test/path_minheap_missing_member/Run()
	var/datum/path_minheap/heap = allocate(/datum/path_minheap)
	// allocate() substitutes a turf for a null first argument; keep node sources null.
	var/datum/PathNode/absent = new(null, null, 0, 0, 0, 0)
	var/datum/PathNode/low = new(null, null, 10, 0, 0, 0)
	var/datum/PathNode/middle = new(null, null, 20, 0, 0, 0)
	var/datum/PathNode/high = new(null, null, 30, 0, 0, 0)
	allocated += list(absent, low, middle, high)

	heap.ReSort(absent)
	heap.ReSort(null)
	TEST_ASSERT_EQUAL(length(heap.L), 0, "Missing-member repair must leave an empty heap empty.")
	TEST_ASSERT_EQUAL(heap.Pop(), 0, "An empty heap must retain its Pop() sentinel.")

	heap.Insert(middle)
	heap.ReSort(absent)
	heap.ReSort(null)
	TEST_ASSERT_EQUAL(length(heap.L), 1, "Missing-member repair must preserve a singleton heap.")
	TEST_ASSERT_EQUAL(heap.L[1], middle, "Missing-member repair must preserve the singleton identity.")
	heap.ReSort(middle)
	TEST_ASSERT_EQUAL(heap.L[1], middle, "An existing singleton must still be repairable.")

	heap.Insert(high)
	heap.Insert(low)
	var/list/before = heap.List()
	heap.ReSort(absent)
	heap.ReSort(null)
	TEST_ASSERT_EQUAL(length(heap.L), length(before), "Missing-member repair must preserve heap membership.")
	for(var/index in 1 to length(before))
		TEST_ASSERT_EQUAL(heap.L[index], before[index], "Missing-member repair must preserve every queue position.")

	TEST_ASSERT_EQUAL(heap.Pop(), low, "The minimum member must pop first.")
	low.setp(null, 1, 0, 0)
	before = heap.List()
	heap.ReSort(low)
	TEST_ASSERT_EQUAL(length(heap.L), length(before), "Repairing a popped node must not reinsert it.")
	for(var/index in 1 to length(before))
		TEST_ASSERT_EQUAL(heap.L[index], before[index], "Repairing a popped node must preserve the remaining queue.")
	TEST_ASSERT_EQUAL(low.f, 1, "Ignoring a popped node must not undo the caller's priority change.")
	TEST_ASSERT_EQUAL(heap.Pop(), middle, "The next queued member must retain its priority.")
	TEST_ASSERT_EQUAL(heap.Pop(), high, "The final queued member must retain its priority.")
	heap.ReSort(high)
	TEST_ASSERT_EQUAL(length(heap.L), 0, "Repairing the last popped node must leave the heap empty.")
	TEST_ASSERT_EQUAL(heap.Pop(), 0, "The drained heap must retain its Pop() sentinel.")

/datum/unit_test/path_minheap_existing_member/Run()
	var/datum/path_minheap/heap = allocate(/datum/path_minheap)
	var/datum/PathNode/low = new(null, null, 10, 0, 0, 0)
	var/datum/PathNode/second = new(null, null, 20, 0, 0, 0)
	var/datum/PathNode/middle = new(null, null, 30, 0, 0, 0)
	var/datum/PathNode/high = new(null, null, 40, 0, 0, 0)
	var/datum/PathNode/changed = new(null, null, 50, 0, 0, 0)
	allocated += list(low, second, middle, high, changed)
	for(var/datum/PathNode/node in list(middle, low, second, changed, high))
		heap.Insert(node)

	changed.setp(null, 5, 0, 0)
	heap.ReSort(changed)
	TEST_ASSERT_EQUAL(heap.L[1], changed, "Decreasing an existing leaf's priority must move it to the root.")
	changed.setp(null, 45, 0, 0)
	heap.ReSort(changed)
	TEST_ASSERT_EQUAL(heap.L[1], low, "Increasing the root's priority must restore the minimum member.")

	var/list/before = heap.List()
	heap.ReSort(second)
	TEST_ASSERT_EQUAL(length(heap.L), length(before), "Existing-member repair must not change membership.")
	for(var/index in 1 to length(before))
		TEST_ASSERT_EQUAL(heap.L[index], before[index], "An unchanged priority must preserve this queue's order.")
	for(var/datum/PathNode/expected in list(low, second, middle, high, changed))
		TEST_ASSERT_EQUAL(heap.Pop(), expected, "Reprioritized members must pop in ascending priority order.")
	TEST_ASSERT_EQUAL(heap.Pop(), 0, "Existing-member repair must not duplicate nodes.")

	// Equal-priority repair must retain the existing strict-comparison tie behavior.
	second.setp(null, 10, 0, 0)
	heap.Insert(low)
	heap.Insert(second)
	heap.ReSort(second)
	TEST_ASSERT_EQUAL(heap.Pop(), low, "An equal-priority child must not displace the root during repair.")
	TEST_ASSERT_EQUAL(heap.Pop(), second, "The equal-priority child must remain queued exactly once.")
	TEST_ASSERT_EQUAL(heap.Pop(), 0, "Equal-priority repair must not duplicate nodes.")

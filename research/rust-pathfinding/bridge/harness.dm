/proc/invoke(s)
    return call_ext("./libsnapshot.so", "snapshot_bridge")(s)
/proc/check(actual,expected,label)
    if(actual != expected)
        world.log << "FAIL [label]: [actual] expected [expected]"
        world.log << "FAILURE_TEARDOWN [invoke("2|join")]"
        shutdown()
    world.log << "PASS [label]"
/proc/retry(s)
    for(var/i in 1 to 100)
        var/r = invoke(s)
        if(r != "contended")
            return r
        sleep(1)
    return "TIMEOUT"
/proc/result()
    for(var/i in 1 to 100)
        var/r = invoke("2|poll")
        if(r != "empty" && r != "contended")
            return r
        sleep(1)
    return "TIMEOUT"
/proc/run_case(name, filename, expected)
    var/payload = file2text(filename)
    check(retry(payload),"accepted","[name]-accepted")
    check(invoke(payload),"busy","[name]-capacity")
    check(invoke("2|submit|bad"),"invalid","[name]-invalid-does-not-consume")
    // Deliberately drop the DM reference before worker completion polling.
    payload = null
    var/actual = result()
    check(actual,expected,"[name]-exact-outcome-identity-path")
    world.log << "CASE_RESULT [name] [actual]"
/proc/run_bad(filename)
    check(invoke(file2text(filename)),"invalid",filename)
/world/New()
    ..()
    check(invoke("2|init"),"ready","init")
    run_bad("payloads/bad_count_zero.txt")
    run_bad("payloads/bad_count_over.txt")
    run_bad("payloads/bad_identity_overflow.txt")
    run_bad("payloads/bad_plus_decimal.txt")
    run_bad("payloads/bad_negative_parameter.txt")
    run_bad("payloads/bad_nan_parameter.txt")
    run_bad("payloads/bad_truncated.txt")
    run_bad("payloads/bad_trailing.txt")
    run_bad("payloads/bad_terminal_start.txt")
    run_bad("payloads/bad_escape_closure.txt")
    run_bad("payloads/bad_goal_cost_conflict.txt")
    run_bad("payloads/bad_duplicate_conflict.txt")
    run_bad("payloads/bad_cap_exact.txt")
    run_bad("payloads/bad_cap_over.txt")
    run_case("human_npc_same_turf", "payloads/human_npc_same_turf.txt", "result|18446744073709551615|2|3|4|5|6|7|False|")
    run_case("human_npc_open_short", "payloads/human_npc_open_short.txt", "result|18446744073709551614|2|3|4|5|6|7|Path|26,27,28,29,30")
    run_case("human_npc_equal_routes", "payloads/human_npc_equal_routes.txt", "result|18446744073709551613|2|3|4|5|6|7|Path|26,38,50,62,74,86,87,88,89,90")
    run_case("human_npc_exclude", "payloads/human_npc_exclude.txt", "result|18446744073709551612|2|3|4|5|6|7|Path|26,27,28,40,41,42,30,31")
    run_case("human_cached_or_frenzy_same_turf", "payloads/human_cached_or_frenzy_same_turf.txt", "result|18446744073709551611|2|3|4|5|6|7|False|")
    run_case("human_cached_or_frenzy_open_short", "payloads/human_cached_or_frenzy_open_short.txt", "result|18446744073709551610|2|3|4|5|6|7|Path|26,27,28,29,30")
    run_case("human_cached_or_frenzy_equal_routes", "payloads/human_cached_or_frenzy_equal_routes.txt", "result|18446744073709551609|2|3|4|5|6|7|Path|26,38,50,62,74,86,87,88,89,90")
    run_case("human_cached_or_frenzy_exclude", "payloads/human_cached_or_frenzy_exclude.txt", "result|18446744073709551608|2|3|4|5|6|7|Path|26,27,28,40,41,42,30,31")
    var/payload = file2text("payloads/human_npc_open_short.txt")
    check(retry(payload),"accepted","cancel-admit")
    check(invoke("2|cancel"),"cancel-requested","cancel-request")
    check(result(),"cancelled","cancelled-result")
    check(retry(payload),"accepted","supersede-admit")
    check(invoke("2|supersede"),"supersede-requested","supersede-request")
    check(result(),"superseded","superseded-result")
    var/expired = replacetext(payload, "|10000|144|", "|0|144|")
    check(retry(expired),"accepted","expired-admit")
    check(result(),"expired","expired-result")
    check(retry(payload),"accepted","stop-admit")
    check(retry("2|stop"),"stop-requested","stop")
    check(invoke("2|poll"),"stopped","stop-invalidates")
    check(invoke("2|join"),"JOINED","completed-join")
    check(invoke("2|init"),"ready","reinit-after-join")
    check(retry(payload),"accepted","panic-admit")
    check(invoke("2|panic"),"worker-failed","caught-boundary-panic")
    check(invoke("2|poll"),"worker-failed","sticky-failure")
    check(invoke("2|join"),"JOINED","completed-failed-join")
    world.log << "SNAPSHOT_BRIDGE_PASS eight frozen scenes all joined"
    shutdown()
